# Factory Finance — 本地开发环境变量示例
# 复制为 .env 后按需修改。真实密码与 Secret 不得提交到 Git。

# ================= MySQL =================
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=factory_finance
MYSQL_USER=factory
MYSQL_PASSWORD=change_app_password
# 仅绑定本机回环，不暴露公网
MYSQL_PORT=3306
MYSQL_IMAGE=mysql:8.4

# ================= Backend =================
# 宿主机映射端口（容器内部固定 8080，Nginx/健康检查均使用容器网络内 8080）
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# docker-compose 内部网络使用 mysql 主机名；本地直跑后端时改为 127.0.0.1
DB_URL=jdbc:mysql://mysql:3306/factory_finance?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
DB_USERNAME=factory
DB_PASSWORD=change_app_password
# JWT 签名密钥，至少 32 字节随机字符串；生产环境必须通过环境变量注入
JWT_SECRET=change_to_a_long_random_secret_at_least_32_bytes

# ================= Frontend / Nginx =================
FRONTEND_PORT=8088
