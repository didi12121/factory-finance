{
  "name": "factory-finance-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build",
    "build:test": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build --mode test",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tanstack/vue-table": "8.21.3",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "@lucide/vue": "1.81.0",
    "pinia": "3.0.4",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.1",
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
